<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CampusCuisine.Views.OrderSummaryBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <Grid BackgroundColor="White" Padding="12" ColumnDefinitions="*,Auto">
    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
      <Label x:Name="OrderTotalLabel"
             Text="0 items"
             FontAttributes="Bold"
             TextColor="Black" />
      <Label x:Name="OrderGrandTotalLabel"
             Text="£0.00"
             TextColor="Black" />
    </VerticalStackLayout>

    <Button Text="Order Summary"
            Grid.Column="1"
            Clicked="OnOrderSummaryClicked" />
  </Grid>
</ContentView>
