<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CampusCuisine.Pages.DessertsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CampusCuisine.Views"
    Title="Desserts"
    BackgroundColor="White">

  <ContentPage.Resources>
    <Color x:Key="DessertInk">#3E2130</Color>
    <Color x:Key="DessertBerry">#B64B78</Color>
    <Color x:Key="DessertRose">#F6D9E5</Color>
    <Color x:Key="DessertCream">#FFF8F2</Color>
    <Color x:Key="DessertCaramel">#D59A4C</Color>
    <Color x:Key="DessertChocolate">#69412B</Color>
    <Color x:Key="DessertPanel">#FFFCFA</Color>

    <LinearGradientBrush x:Key="DessertPageBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFF9F4" Offset="0.0" />
      <GradientStop Color="#FCE9F0" Offset="0.45" />
      <GradientStop Color="#FFF1E0" Offset="1.0" />
    </LinearGradientBrush>

    <!--
      Sanctioned distinct theme: structural shape is inherited from the
      shared Brand* styles so padding, corner radius, and stroke thickness
      stay consistent across the app; only colour setters are overridden
      to keep the Dessert page visually differentiated as the brief
      explicitly allows.
    -->
    <Style x:Key="DessertTag" TargetType="Border" BasedOn="{StaticResource BrandTag}">
      <Setter Property="BackgroundColor" Value="{StaticResource DessertRose}" />
      <Setter Property="Stroke" Value="{StaticResource DessertBerry}" />
    </Style>

    <Style x:Key="DessertSectionCard" TargetType="Border" BasedOn="{StaticResource BrandCard}">
      <Setter Property="Padding" Value="18" />
      <Setter Property="BackgroundColor" Value="{StaticResource DessertPanel}" />
      <Setter Property="Stroke" Value="{StaticResource DessertRose}" />
    </Style>
  </ContentPage.Resources>

  <Grid RowDefinitions="Auto,*,Auto"
        Padding="20"
        RowSpacing="16"
        Background="{StaticResource DessertPageBrush}">

    <Border Grid.Row="0"
            Padding="24"
            Stroke="{StaticResource DessertBerry}"
            BackgroundColor="{StaticResource DessertCream}"
            StrokeShape="RoundRectangle 28">
      <VerticalStackLayout Spacing="14">
        <Label
            Text="Desserts"
            FontSize="30"
            FontAttributes="Bold"
            TextColor="{StaticResource DessertInk}" />

        <Label
            Text="Finish the order with something warm, chilled, or indulgent."
            FontSize="15"
            TextColor="{StaticResource DessertInk}" />

        <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Start">
          <Border Style="{StaticResource DessertTag}">
            <Label Text="Sweet finish" TextColor="{StaticResource DessertInk}" FontAttributes="Bold" />
          </Border>

          <Border Style="{StaticResource DessertTag}">
            <Label Text="Rich flavours" TextColor="{StaticResource DessertInk}" FontAttributes="Bold" />
          </Border>
        </FlexLayout>
      </VerticalStackLayout>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource DessertSectionCard}" Padding="0">
      <Grid RowDefinitions="Auto,*" Padding="18">
        <Label Grid.Row="0"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               TextColor="{StaticResource BrandError}"
               FontAttributes="Bold"
               Margin="0,0,0,12" />

        <views:MenuItemView
            Grid.Row="1"
            Items="{Binding MenuItems}" />
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Padding="12"
            BackgroundColor="{StaticResource DessertCream}"
            Stroke="{StaticResource DessertBerry}"
            StrokeShape="RoundRectangle 22">
      <views:OrderSummaryBar />
    </Border>
  </Grid>
</ContentPage>
