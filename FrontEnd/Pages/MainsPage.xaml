<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CampusCuisine.Pages.MainsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CampusCuisine.Views"
    Title="Mains"
    BackgroundColor="White">

  <Grid RowDefinitions="Auto,*,Auto" Padding="20">
    <Label
            Text="Mains"
            FontSize="28"
            FontAttributes="Bold"
            TextColor="Black"
            Grid.Row="0"
            Margin="0,0,0,15" />

    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="Red" Margin="0,50,0,10" />

    <views:MenuItemView
            Grid.Row="1"
            Items="{Binding MenuItems}" />

    <!-- Order summary bar -->
    <Grid Grid.Row="2" BackgroundColor="White" Padding="12" ColumnDefinitions="*,Auto">
      <VerticalStackLayout Spacing="2" VerticalOptions="Center">
        <Label x:Name="OrderTotalLabel"
               Text="0 items"
               FontAttributes="Bold"
               TextColor="Black" />
        <Label x:Name="OrderGrandTotalLabel"
               Text="£0.00"
               TextColor="Black" />
      </VerticalStackLayout>
      <Button Text="Order Summary" Grid.Column="1" Clicked="OnOrderSummaryClicked" />
    </Grid>
  </Grid>
</ContentPage>
