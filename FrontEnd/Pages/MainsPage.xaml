<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CampusCuisine.Pages.MainsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CampusCuisine.Views"
    Title="Mains"
    BackgroundColor="White">

  <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="16">
    <VerticalStackLayout Grid.Row="0" Spacing="8">
      <Label Text="Mains"
             Style="{StaticResource BrandSubTitle}" />

      <Label Text="Build the core of your order from our main dishes."
             Style="{StaticResource BrandBodyText}" />

      <Label Text="{Binding ErrorMessage}"
             IsVisible="{Binding HasError}"
             Style="{StaticResource BrandErrorText}"
             Margin="0,6,0,0" />
    </VerticalStackLayout>

    <views:MenuItemView
            Grid.Row="1"
            Items="{Binding MenuItems}" />

    <views:OrderSummaryBar Grid.Row="2" />
  </Grid>
</ContentPage>
