<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CampusCuisine.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Home"
    BackgroundColor="White">

  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="20">

      <Border
        Stroke="Black"
        StrokeShape="0"
        Padding="20">

        <VerticalStackLayout Spacing="15">
          <Label
            Text="Welcome to Campus Cuisine"
            FontSize="28"
            TextColor="Black"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

          <BoxView HeightRequest="1" BackgroundColor="Black" />

          <Label
            Text="Welcome to Campus Cuisine. Use the flyout navigation to browse Starters, Mains, and Desserts."
            FontSize="16" />

        </VerticalStackLayout>
      </Border>

      <!-- Current order status -->
      <Border Stroke="LightGray" Padding="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <VerticalStackLayout>
            <Label Text="Current Order" FontAttributes="Bold" TextColor="Black" />
            <Label Text="{Binding TotalItemsText}" TextColor="Black" />
            <Label Text="{Binding GrandTotalText}" TextColor="Black" />
          </VerticalStackLayout>

          <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
            <Button Text="Start New Order" Clicked="OnStartNewOrderClicked" />
            <Button Text="Continue Current Order"
                    Clicked="OnContinueOrderClicked"
                    IsVisible="{Binding HasOrder}"
                    IsEnabled="{Binding HasOrder}" />
          </VerticalStackLayout>
        </Grid>
      </Border>

      <VerticalStackLayout Spacing="12" Padding="20">
        <!-- Secondary actions if needed -->
        <Label Text="Quick access:" FontAttributes="Bold" />
      </VerticalStackLayout>

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
