<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CampusCuisine.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Home"
    BackgroundColor="White">

  <ContentPage.Resources>
    <Color x:Key="HomeInk">#1F2430</Color>
    <Color x:Key="HomeAccent">#A7652A</Color>
    <Color x:Key="HomeAccentSoft">#F5E0CB</Color>
    <Color x:Key="HomeOlive">#4E6330</Color>
    <Color x:Key="HomeCream">#FFFDF8</Color>
    <Color x:Key="HomePanel">#FFF7EF</Color>
    <Color x:Key="HomePanelAlt">#FFF4E7</Color>
    <Color x:Key="HomeBorder">#E8D1BC</Color>

    <LinearGradientBrush x:Key="HomePageBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFDF8" Offset="0.0" />
      <GradientStop Color="#FFF7EF" Offset="0.5" />
      <GradientStop Color="#F9EFE4" Offset="1.0" />
    </LinearGradientBrush>

    <Style x:Key="HomePanelCard" TargetType="Border">
      <Setter Property="Padding" Value="20" />
      <Setter Property="BackgroundColor" Value="{StaticResource HomeCream}" />
      <Setter Property="Stroke" Value="{StaticResource HomeBorder}" />
      <Setter Property="StrokeShape" Value="RoundRectangle 24" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="HomeTag" TargetType="Border">
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="BackgroundColor" Value="{StaticResource HomeAccentSoft}" />
      <Setter Property="Stroke" Value="{StaticResource HomeAccent}" />
      <Setter Property="StrokeShape" Value="RoundRectangle 999" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="HomeStatCard" TargetType="Border">
      <Setter Property="Padding" Value="14" />
      <Setter Property="BackgroundColor" Value="{StaticResource HomePanelAlt}" />
      <Setter Property="Stroke" Value="{StaticResource HomeBorder}" />
      <Setter Property="StrokeShape" Value="RoundRectangle 18" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>
  </ContentPage.Resources>

  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="20" Background="{StaticResource HomePageBrush}">

      <Border Style="{StaticResource HomePanelCard}"
              Stroke="{StaticResource HomeAccent}"
              BackgroundColor="{StaticResource HomePanel}">

        <VerticalStackLayout Spacing="16">
          <Label
              Text="Campus Cuisine"
              FontSize="34"
              TextColor="{StaticResource HomeInk}"
              FontAttributes="Bold" />

          <Label
              Text="Order across Starters, Mains, and Desserts from one shared basket, then review everything before checkout."
              FontSize="16"
              TextColor="{StaticResource HomeInk}" />

          <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Start">
            <Border Style="{StaticResource HomeTag}">
              <Label Text="Fast ordering" TextColor="{StaticResource HomeInk}" FontAttributes="Bold" />
            </Border>

            <Border Style="{StaticResource HomeTag}">
              <Label Text="Shared basket" TextColor="{StaticResource HomeInk}" FontAttributes="Bold" />
            </Border>

            <Border Style="{StaticResource HomeTag}">
              <Label Text="Clear totals" TextColor="{StaticResource HomeInk}" FontAttributes="Bold" />
            </Border>
          </FlexLayout>
        </VerticalStackLayout>
      </Border>

      <Border IsVisible="{Binding FeaturedIsVisible}"
              Style="{StaticResource HomePanelCard}"
              BackgroundColor="{StaticResource HomeAccentSoft}"
              Stroke="{StaticResource HomeAccent}">
        <VerticalStackLayout Spacing="14">
          <Label Text="Today's pick"
                 FontAttributes="Bold"
                 FontSize="22"
                 TextColor="{StaticResource HomeInk}" />

          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="14"
                RowDefinitions="Auto,Auto,Auto">
            <Image Grid.Column="0"
                   Grid.RowSpan="3"
                   Source="{Binding FeaturedImageUrl}"
                   WidthRequest="96"
                   HeightRequest="96"
                   Aspect="AspectFill" />

            <Label Grid.Row="0"
                   Grid.Column="1"
                   Text="{Binding FeaturedName}"
                   FontAttributes="Bold"
                   FontSize="18"
                   TextColor="{StaticResource HomeInk}" />

            <Label Grid.Row="1"
                   Grid.Column="1"
                   Text="{Binding FeaturedDescription}"
                   FontSize="13"
                   TextColor="{StaticResource HomeInk}" />

            <Label Grid.Row="2"
                   Grid.Column="1"
                   Text="{Binding FeaturedPriceText}"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="{StaticResource HomeAccent}" />
          </Grid>

          <Button Text="View in Mains"
                  Clicked="OnQuickNavigateClicked"
                  CommandParameter="//MainsPage" />
        </VerticalStackLayout>
      </Border>

      <Border Style="{StaticResource HomePanelCard}">
        <VerticalStackLayout Spacing="16">
          <Label
              Text="Current Order"
              FontAttributes="Bold"
              FontSize="22"
              TextColor="{StaticResource HomeInk}" />

          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource HomeStatCard}">
              <VerticalStackLayout Spacing="4">
                <Label Text="Items"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{StaticResource HomeOlive}" />
                <Label Text="{Binding TotalItemsText}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource HomeInk}" />
              </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource HomeStatCard}">
              <VerticalStackLayout Spacing="4">
                <Label Text="Grand total"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{StaticResource HomeOlive}" />
                <Label Text="{Binding GrandTotalText}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource HomeInk}" />
              </VerticalStackLayout>
            </Border>
          </Grid>

          <Label
              Text="Start a fresh basket or continue with the order already in progress."
              TextColor="{StaticResource HomeInk}" />

          <VerticalStackLayout Spacing="10">
            <Button Text="Start New Order" Clicked="OnStartNewOrderClicked" />
            <Button Text="Continue Current Order"
                    Clicked="OnContinueOrderClicked"
                    IsVisible="{Binding HasOrder}"
                    IsEnabled="{Binding HasOrder}" />
          </VerticalStackLayout>
        </VerticalStackLayout>
      </Border>

      <Border Style="{StaticResource HomePanelCard}">
        <VerticalStackLayout Spacing="14">
          <Label
              Text="Quick access"
              FontAttributes="Bold"
              FontSize="22"
              TextColor="{StaticResource HomeInk}" />

          <Border Style="{StaticResource HomeStatCard}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <VerticalStackLayout Spacing="4">
                <Label Text="Browse Starters" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource HomeInk}" />
                <Label Text="Open lighter dishes and appetisers first." TextColor="{StaticResource HomeInk}" />
              </VerticalStackLayout>
              <Button Grid.Column="1"
                      Text="Open"
                      Clicked="OnQuickNavigateClicked"
                      CommandParameter="//StartersPage"
                      VerticalOptions="Center" />
            </Grid>
          </Border>

          <Border Style="{StaticResource HomeStatCard}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <VerticalStackLayout Spacing="4">
                <Label Text="Browse Mains" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource HomeInk}" />
                <Label Text="Jump straight to main dishes and build the core of the order." TextColor="{StaticResource HomeInk}" />
              </VerticalStackLayout>
              <Button Grid.Column="1"
                      Text="Open"
                      Clicked="OnQuickNavigateClicked"
                      CommandParameter="//MainsPage"
                      VerticalOptions="Center" />
            </Grid>
          </Border>

          <Border Style="{StaticResource HomeStatCard}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <VerticalStackLayout Spacing="4">
                <Label Text="Browse Desserts" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource HomeInk}" />
                <Label Text="Finish the basket with something sweet from the themed dessert page." TextColor="{StaticResource HomeInk}" />
              </VerticalStackLayout>
              <Button Grid.Column="1"
                      Text="Open"
                      Clicked="OnQuickNavigateClicked"
                      CommandParameter="//DessertsPage"
                      VerticalOptions="Center" />
            </Grid>
          </Border>

          <Border Style="{StaticResource HomeStatCard}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <VerticalStackLayout Spacing="4">
                <Label Text="Need help?" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource HomeInk}" />
                <Label Text="Open the Help page for ordering guidance and recovery steps." TextColor="{StaticResource HomeInk}" />
              </VerticalStackLayout>
              <Button Grid.Column="1"
                      Text="Help"
                      Clicked="OnQuickNavigateClicked"
                      CommandParameter="//HelpPage"
                      VerticalOptions="Center" />
            </Grid>
          </Border>
        </VerticalStackLayout>
      </Border>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
