<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CampusCuisine.Pages.OrderSummaryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CampusCuisine.ViewModel;assembly=CampusCuisine.Core"
    Title="Order Summary">

  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="16">

      <Label Text="Order Summary"
             Style="{StaticResource BrandSubTitle}" />

      <CollectionView x:Name="SummaryCollection"
                      ItemsSource="{Binding Lines}">
        <CollectionView.EmptyView>
          <Label Text="Your order is empty." />
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="vm:OrderSummaryLineViewModel">
            <Border Padding="10" Margin="0,4">
              <VerticalStackLayout Spacing="8">

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                  <Label Grid.Row="0"
                         Grid.Column="0"
                         Text="{Binding Name}"
                         FontAttributes="Bold" />

                  <Label Grid.Row="0"
                         Grid.Column="1"
                         Text="{Binding UnitPrice, StringFormat='Unit: £{0:F2}'}" />

                  <Label Grid.Row="1"
                         Grid.Column="0"
                         Grid.ColumnSpan="2"
                         Text="{Binding Description}"
                         FontSize="12" />

                  <Label Grid.Row="2"
                         Grid.Column="0"
                         Text="{Binding LineTotal, StringFormat='Line total: £{0:F2}'}"
                         FontAttributes="Bold" />

                  <Label Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding Quantity, StringFormat='Qty: {0}'}" />
                </Grid>

                <HorizontalStackLayout Spacing="8">
                  <Button Text="-"
                          WidthRequest="50"
                          Command="{Binding DecreaseCommand}" />

                  <Entry WidthRequest="70"
                         Keyboard="Numeric"
                         HorizontalTextAlignment="Center"
                         Text="{Binding QuantityText, Mode=TwoWay}"
                         Completed="OnQuantityEntryCompleted"
                         Unfocused="OnQuantityEntryUnfocused" />

                  <Button Text="+"
                          WidthRequest="50"
                          Command="{Binding IncreaseCommand}" />

                  <Button Text="Remove"
                          Command="{Binding RemoveCommand}" />
                </HorizontalStackLayout>

              </VerticalStackLayout>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>

      <Label Text="{Binding TotalItemsText}"
             FontAttributes="Bold" />

      <Label Text="{Binding GrandTotalText}"
             FontSize="18"
             FontAttributes="Bold" />

      <Button Text="Clear Order"
              Command="{Binding ClearOrderCommand}" />

      <Button x:Name="PlaceOrderButton"
              Text="{Binding PlaceOrderButtonText}"
              Clicked="OnPlaceOrderClicked"
              Command="{Binding PlaceOrderCommand}" />

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
